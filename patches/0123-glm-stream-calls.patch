+def stream_calls(value: str | None = None) -> bool:
+    """``TF_GLM_STREAM_CALLS``: 1 sends a GLM call's header once its name is written and its arguments' JSON in
+    pieces as they arrive (OpenAI's tool-call streaming, so a large call is not silent while it is generated);
+    0 (the default) holds each call whole until its ``</tool_call>`` (patches 0053/0055)."""
+
+    raw = (os.environ.get("TF_GLM_STREAM_CALLS", "0") if value is None else value).strip() or "0"
+    if raw not in ("0", "1"):
+        raise ValueError(f"TF_GLM_STREAM_CALLS={raw!r}: expected 0 or 1")
+    return raw == "1"
+
